+//
+// split state io: metadata to/from host memory, tensor data to/from a ggml backend buffer
+//
+
+// Copies `size` bytes between a region of `t` (at byte offset `t_off`) and `buf` (at byte offset `buf_off`),
+// through 1-D I8 aliases so that ggml picks the fastest path (device-to-device, host<->device, or memcpy).
+static void llama_split_copy(ggml_context * c, ggml_tensor * t, size_t t_off, ggml_backend_buffer_t buf, size_t buf_off,
+                             size_t size, bool to_buf) {
+    ggml_reset(c);
+    ggml_tensor * a = ggml_new_tensor_1d(c, GGML_TYPE_I8, (int64_t) size);
+    ggml_tensor * b = ggml_new_tensor_1d(c, GGML_TYPE_I8, (int64_t) size);
+    ggml_backend_buffer_t t_buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (ggml_backend_tensor_alloc(t_buf, a, (char *) t->data + t_off) != GGML_STATUS_SUCCESS ||
+        ggml_backend_tensor_alloc(buf,   b, (char *) ggml_backend_buffer_get_base(buf) + buf_off) != GGML_STATUS_SUCCESS) {
+        throw std::runtime_error("split state: failed to alias tensor or buffer region");
+    }
+    if (to_buf) {
+        ggml_backend_tensor_copy(a, b);
+    } else {
+        ggml_backend_tensor_copy(b, a);
+    }
+}
+
+class llama_io_count_split : public llama_io_write_i {
+public:
+    void write(const void * /* src */, size_t size) override { meta += size; }
+    void write_tensor(ggml_tensor * /* tensor */, size_t /* offset */, size_t size) override { data += size; }
+    size_t n_bytes() override { return meta; }
+    size_t meta = 0, data = 0;
+};
+
+class llama_io_write_split : public llama_io_write_i {
+public:
+    llama_io_write_split(uint8_t * p, size_t len, ggml_backend_buffer_t buf, size_t buf_offset)
+        : ptr(p), meta_left(len), buf(buf), pos(buf_offset) {
+        ggml_init_params params = { 2*ggml_tensor_overhead(), NULL, true };
+        c.reset(ggml_init(params));
+    }
+
+    void write(const void * src, size_t size) override {
+        if (size > meta_left) {
+            throw std::runtime_error("split state: metadata buffer too small");
+        }
+        memcpy(ptr, src, size);
+        ptr += size;
+        meta_left -= size;
+        meta_written += size;
+    }
+
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        if (pos + size > ggml_backend_buffer_get_size(buf)) {
+            throw std::runtime_error("split state: data buffer too small");
+        }
+        llama_split_copy(c.get(), tensor, offset, buf, pos, size, true);
+        pos += size;
+        data_written += size;
+    }
+
+    size_t n_bytes() override { return meta_written; }
+    size_t data_bytes() const { return data_written; }
+
+private:
+    uint8_t * ptr;
+    size_t meta_left;
+    size_t meta_written = 0;
+    ggml_backend_buffer_t buf;
+    size_t pos;
+    size_t data_written = 0;
+    ggml_context_ptr c;
+};
+
+class llama_io_read_split : public llama_io_read_i {
+public:
+    llama_io_read_split(const uint8_t * p, size_t len, ggml_backend_buffer_t buf, size_t buf_offset)
+        : ptr(p), meta_left(len), buf(buf), pos(buf_offset) {
+        ggml_init_params params = { 2*ggml_tensor_overhead(), NULL, true };
+        c.reset(ggml_init(params));
+    }
+
+    void read(void * dst, size_t size) override {
+        if (size > meta_left) {
+            throw std::runtime_error("split state: unexpectedly reached end of metadata");
+        }
+        memcpy(dst, ptr, size);
+        ptr += size;
+        meta_left -= size;
+        meta_read += size;
+    }
+
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        if (pos + size > ggml_backend_buffer_get_size(buf)) {
+            throw std::runtime_error("split state: unexpectedly reached end of data buffer");
+        }
+        llama_split_copy(c.get(), tensor, offset, buf, pos, size, false);
+        pos += size;
+    }
+
+    size_t n_bytes() override { return meta_read; }
+
+private:
+    const uint8_t * ptr;
+    size_t meta_left;
+    size_t meta_read = 0;
+    ggml_backend_buffer_t buf;
+    size_t pos;
+    ggml_context_ptr c;
+};
