+    // Split sequence state, for moving a sequence between contexts without staging the KV data in host memory.
+    // The serialized state is divided into two parts:
+    //   - metadata (cell positions, sequence ids, layer layout), written to / read from host memory `meta`
+    //   - tensor data (K/V, recurrent state), copied to / from the backend buffer `buf` at `buf_offset`
+    // `buf` can be any ggml backend buffer: a GPU buffer (copies stay on the device, e.g. for GPU-aware MPI),
+    // a pinned host buffer or a CPU buffer. The two parts together carry the same information as
+    // llama_state_seq_get_data(), and the formats of sender and receiver contexts must match the same way.
+    // All copies have completed when these functions return.
+#define LLAMA_STATE_SEQ_SPLIT_API 1
+
+    // Returns the metadata size in bytes; *data_size receives the tensor-data size in bytes.
+    LLAMA_API size_t llama_state_seq_get_size_split(
+            struct llama_context * ctx,
+                    llama_seq_id   seq_id,
+                          size_t * data_size,
+           llama_state_seq_flags   flags);
+
+    // Returns the metadata bytes written (0 on failure); *data_size receives the tensor bytes copied to buf.
+    LLAMA_API size_t llama_state_seq_get_data_split(
+            struct llama_context * ctx,
+                         uint8_t * meta,
+                          size_t   meta_size,
+           ggml_backend_buffer_t   buf,
+                          size_t   buf_offset,
+                          size_t * data_size,
+                    llama_seq_id   seq_id,
+           llama_state_seq_flags   flags);
+
+    // Returns the metadata bytes read (0 on failure).
+    LLAMA_API size_t llama_state_seq_set_data_split(
+            struct llama_context * ctx,
+                   const uint8_t * meta,
+                          size_t   meta_size,
+           ggml_backend_buffer_t   buf,
+                          size_t   buf_offset,
+                    llama_seq_id   dest_seq_id,
+           llama_state_seq_flags   flags);
+
