+size_t llama_context::state_seq_get_size_split(llama_seq_id seq_id, size_t * data_size, llama_state_seq_flags flags) {
+    llama_io_count_split io;
+    try {
+        io.write(&io_magic, sizeof(io_magic));
+        io.write(&seq_id, sizeof(seq_id));
+        state_seq_write_data(io, seq_id, flags);
+        if (data_size) {
+            *data_size = io.data;
+        }
+        return io.meta;
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: error getting split state size: %s\n", __func__, err.what());
+        return 0;
+    }
+}
+
+size_t llama_context::state_seq_get_data_split(llama_seq_id seq_id, uint8_t * meta, size_t meta_size,
+                                               ggml_backend_buffer_t buf, size_t buf_offset, size_t * data_size, llama_state_seq_flags flags) {
+    llama_io_write_split io(meta, meta_size, buf, buf_offset);
+    try {
+        io.write(&io_magic, sizeof(io_magic));
+        io.write(&seq_id, sizeof(seq_id));
+        state_seq_write_data(io, seq_id, flags);
+        if (data_size) {
+            *data_size = io.data_bytes();
+        }
+        return io.n_bytes();
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: error saving split state: %s\n", __func__, err.what());
+        return 0;
+    }
+}
+
+size_t llama_context::state_seq_set_data_split(llama_seq_id seq_id, const uint8_t * meta, size_t meta_size,
+                                               ggml_backend_buffer_t buf, size_t buf_offset, llama_state_seq_flags flags) {
+    llama_io_read_split io(meta, meta_size, buf, buf_offset);
+    try {
+        uint32_t magic_read;
+        io.read(&magic_read, sizeof(magic_read));
+        if (io_magic != magic_read) {
+            throw std::runtime_error("wrong sequence state magic");
+        }
+        llama_seq_id seq_id_read;
+        io.read(&seq_id_read, sizeof(seq_id_read));
+        state_seq_read_data(io, seq_id, flags);
+        return io.n_bytes();
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: error loading split state: %s\n", __func__, err.what());
+        io.discard();
+        return 0;
+    }
+}
